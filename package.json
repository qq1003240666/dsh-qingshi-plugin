{
  "name": "dsh-qingshi",
  "version": "0.16.0",
  "description": "青史（Qingshi）日记与族谱助手 —— DSH 插件，同时也是 MCP server，Codex / Claude Code / Cursor 等任何 MCP 客户端都能用。",
  "type": "module",
  "license": "MIT",
  "author": "qq1003240666",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq1003240666/dsh-qingshi-plugin.git"
  },
  "homepage": "https://github.com/qq1003240666/dsh-qingshi-plugin#readme",
  "bugs": {
    "url": "https://github.com/qq1003240666/dsh-qingshi-plugin/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "qingshi",
    "diary",
    "family-tree",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor"
  ],
  "engines": {
    "node": ">=22.4.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "install.mjs",
    "lib/*.js",
    "shell/main.js",
    "shell/preload.js",
    "shell/package.json",
    "bin/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "docs/*.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "test/*.mjs",
    "mcp/",
    "bin/qingshi-mcp.mjs",
    "docs/MCP.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/mcp.mjs"
  },
  "bin": {
    "qingshi-mcp": "./bin/qingshi-mcp.mjs"
  }
}
